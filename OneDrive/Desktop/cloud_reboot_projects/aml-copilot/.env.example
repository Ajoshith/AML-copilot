# --- LLM provider -----------------------------------------------------------
# anthropic | groq. The agents reach the model only through LangChain
# (src/llm/client.ts), so this one variable swaps the whole provider — no agent,
# orchestrator or API code changes. Default: anthropic.
AML_LLM_PROVIDER=anthropic

# Overrides the provider's default model. Defaults: claude-sonnet-5 (anthropic),
# openai/gpt-oss-120b (groq).
# AML_MODEL_ID=

# Whichever provider is selected needs its own key. Neither is required for
# `bun test` (AML_LLM_MODE=replay uses recorded cassettes).
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# --- Cassettes --------------------------------------------------------------
# record | replay | live
# record: call the live API and save the response as a cassette.
# replay: read from a cassette; missing cassette is an error, never a silent live call.
# live: always call the live API, no cassette read or write.
AML_LLM_MODE=replay

# --- Server -----------------------------------------------------------------
# Port the Elysia API listens on.
PORT=8787
