{
  "name": "aml-copilot",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "workspaces": ["ui"],
  "scripts": {
    "data:fetch": "bun run scripts/fetch-data.ts",
    "data:select-cases": "bun run scripts/select-cases.ts",
    "data:build-overlay": "bun run scripts/build-overlay.ts",
    "dev:api": "bun run --watch src/api/main.ts",
    "dev:ui": "cd ui && bun run dev",
    "replay": "bun run src/replay.ts",
    "evaluate": "bun run scripts/evaluate.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/eden": "^1.4.9",
    "@langchain/anthropic": "^1.5.10",
    "@langchain/core": "^1.2.11",
    "@langchain/groq": "^1.3.1",
    "adm-zip": "^0.6.0",
    "cheerio": "^1.2.0",
    "duckdb": "^1.4.4",
    "elysia": "^1.4.30",
    "yaml": "^2.9.0",
    "zod": "^4.6.1"
  }
}
